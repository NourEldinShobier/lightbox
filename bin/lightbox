#!/usr/bin/env bash
# Runs the lightbox CLI. Picks $LIGHTBOX_PYTHON if set, else the first Python 3.9+ on PATH that
# already has the dependencies, else the first Python 3.9+ (so `lightbox setup` installs into it).
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
script="$here/scripts/lightbox.py"
if [ -n "$LIGHTBOX_PYTHON" ]; then exec "$LIGHTBOX_PYTHON" "$script" "$@"; fi
first=""
for py in python3 python py; do
  command -v "$py" >/dev/null 2>&1 || continue
  "$py" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1 || continue
  [ -z "$first" ] && first="$py"
  if "$py" -c 'import PIL, numpy, cv2, potrace, playwright' >/dev/null 2>&1; then exec "$py" "$script" "$@"; fi
done
[ -n "$first" ] && exec "$first" "$script" "$@"
echo "lightbox: Python 3.9+ not found on PATH (or set LIGHTBOX_PYTHON)" >&2
exit 127
